# Konfigurasi Port Backend API
PORT=5000

# Konfigurasi Database MySQL di aaPanel / VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=siapkerja_db
DB_USER=siapkerja_user
DB_PASSWORD=GantiDenganPasswordMySQLAnda

# ============================================================================
# KONFIGURASI AI SUMOPOD.COM (PREMIUM AI INTERVIEW ENGINE)
# ============================================================================
# Masukkan API Key dari sumopod.com Anda di sini
SUMOPOD_API_KEY=your_sumopod_api_key_here

# Pilihan Model AI yang ingin digunakan dari sumopod (misal: gpt-4o-mini, gemini-1.5-flash, claude-3-5-sonnet, deepseek-chat)
SUMOPOD_MODEL=gpt-4o-mini

# Base URL Sumopod (Default: https://ai.sumopod.com/v1)
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# Opsional: Direct Gemini API Key (Fallback jika Sumopod tidak diisi)
GEMINI_API_KEY=
